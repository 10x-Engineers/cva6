    [subst  {[format {tb_top.iopmp_dut.rap.response_generator_inst.rap_wr_err_req}]} ] \
    [subst  {[format {tb_top.iopmp_dut.rap.response_generator_inst.rap_wr_valid}]} ] \
    [subst  {[format {tb_top.iopmp_dut.rap.response_generator_inst.rap_wr_trans}]} ]
}

if {[info exists createdGroup([list {Write Response Path}])]} {
group using {Write Response Path}
group set -overlay 0
group set -comment {}
group clear 0 end
group insert \
    {Slave Wr Resp} \
    {Write Err Resp Buf} \
    {Prio Arb 4}
}

if {[info exists createdGroup([list {Slave Write Path}])]} {
group using {Slave Write Path}
group set -overlay 0
group set -comment {}
group clear 0 end
group insert \
    Wr_Req \
    MSI_Wr_Req \
    Prio_Arb_3
}

if {[info exists createdGroup([list {EIC}])]} {
group using EIC
group set -overlay 0
group set -comment {}
group clear 0 end
group insert \
    [subst  {[format {tb_top.iopmp_dut.gen_eic_block.eic_block.rap_eic_valid}]} ] \
    [subst  {[format {tb_top.iopmp_dut.gen_eic_block.eic_block.rap_eic_trans}]} ] \
    [subst  {[format {tb_top.iopmp_dut.gen_eic_block.eic_block.rap_eic_error_info}]} ] \
    [subst  {[format {tb_top.iopmp_dut.gen_eic_block.eic_block.rfm_eic}]} ] \
    [subst  {[format {tb_top.iopmp_dut.gen_eic_block.eic_block.err_rec_en}]} ] \
    [subst  {[format {tb_top.iopmp_dut.gen_eic_block.eic_block.generate_intrpt}]} ] \
    [subst  {[format {tb_top.iopmp_dut.gen_eic_block.eic_block.eic_rfm_valid}]} ] \
    [subst  {[format {tb_top.iopmp_dut.gen_eic_block.eic_block.eic_rfm_err_rrid[5:0]}]} ] \
    [subst  {[format {tb_top.iopmp_dut.gen_eic_block.eic_block.eic_msi_valid}]} ] \
    [subst  {[format {tb_top.iopmp_dut.gen_eic_block.eic_block.msi_address[51:0]}]} ] \
    [subst  {[format {tb_top.iopmp_dut.gen_eic_block.eic_block.eic_msi_trans}]} ] \
    [subst  {[format {tb_top.iopmp_dut.gen_eic_block.eic_block.wsi}]} ] \
    [subst  {[format {tb_top.iopmp_dut.gen_eic_block.eic_block.eic_rfm}]} ]
}

