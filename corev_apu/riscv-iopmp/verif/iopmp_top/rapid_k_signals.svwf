if {[info exists createdGroup([list {TTU}])]} {
group using TTU
group set -overlay 0
group set -comment {}
group clear 0 end
group insert \
    [subst  {[format {tb_top.iopmp_dut.ttu.rap_operation[1:0]}]} ] \
    [subst  {[format {tb_top.iopmp_dut.ttu.transaction_i}]} ] \
    [subst  {[format {tb_top.iopmp_dut.ttu.rfm_ttu}]} ] \
    TTU_Checks \
    {SRCMD Lookup} \
    {_4KB Check} \
    [subst  {[format {tb_top.iopmp_dut.ttu.ttu_rapo[1:0]}]} ] \
    [subst  {[format {tb_top.iopmp_dut.ttu.ttu_rap_err_info[3:0]}]} ] \
    [subst  {[format {tb_top.iopmp_dut.ttu.transaction_o}]} ] \
    [subst  {[format {tb_top.iopmp_dut.ttu.trans_end_addr[51:0]}]} ] \
    [subst  {[format {tb_top.iopmp_dut.ttu.entrypresent_or[125:0]}]} ] \
    [subst  {[format {tb_top.iopmp_dut.ttu.mdrwperm_repl[125:0]}]} ] \
    [subst  {[format {tb_top.iopmp_dut.ttu.entrypresent_or[125:0]}]} ]
}

