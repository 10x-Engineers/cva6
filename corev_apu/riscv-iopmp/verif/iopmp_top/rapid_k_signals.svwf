if {[info exists createdGroup([list {MSTR_REQ_MGR}])]} {
group using MSTR_REQ_MGR
group set -overlay 0
group set -comment {}
group clear 0 end
group insert \
    Read_Req \
    Write_Req \
    RR_Arb_1 \
    {Stall Logic} \
    PRIO_Arb_2 \
    {Wr data} \
    {TTU Signals}
}

if {[info exists createdGroup([list {RFM}])]} {
group using RFM
group set -overlay 0
group set -comment {}
group clear 0 end
group insert \
    FSM \
    {Address Check} \
    {Read Path} \
    {Write Path}
}

