addrmap iopmp_reg {
    name = "I/O Physical Memory Protection";
    desc = "I/O Physical Memory Protection";

    default accesswidth = 32;
    addressing = regalign;
    rsvdset = false;

    reg {
        name = "VERSION";
        desc = "INFO registers are use to indicate the IOPMP instance configuration info.";
        regwidth=32;

        field {
            name = "vendor";
            desc = "The JEDEC manufacturer ID.";
            hw   = r;
            sw   = r;
        } vendor[23:0] = 0x0;

        field {
            name = "specver";
            desc = "The specification version";
            hw   = r;
            sw   = r;
        } specver[31:24] = 0x0;

    } version @ 0x0;

    reg {
        name = "IMPLEMENTATION";
        desc = "";
        regwidth = 32;

        field {
            name = "impid";
            desc = "";
            hw   = r;
            sw   = r;
        } impid[31:0] = 0x0;

    } implementation @ 0x4;

    reg {
        name = "HWCFG0";
        desc = "";
        regwidth=32;

        field {
            name = "mdcfg_fmt";
            desc = "";
            hw   = rw;
            sw   = r;
        } mdcfg_fmt[1:0] = 0x0;

        field {
            name = "srcmd_fmt";
            desc = "";
            hw   = rw;
            sw   = r;
        } srcmd_fmt[3:2] = 0x0;

        field {
            name = "tor_en";
            desc = "The specification version";
            hw   = rw;
            sw   = r;
        } tor_en[4:4] = 0x1;

        field {
            name = "sps_en";
            desc = "The specification version";
            hw   = rw;
            sw   = r;
        } sps_en[5:5] = 0x1;

        field {
            name = "user_cfg_en";
            desc = "The specification version";
            hw   = rw;
            sw   = r;
        } user_cfg_en[6:6] = 0x0;

        field {
            name = "prient_prog";
            desc = "The specification version";
            hw   = rw;
            sw   = rw;
            we;
            onwrite = woclr;
        } prient_prog[7:7] = 0x1;

        field {
            name = "rrid_transl_en";
            desc = "The specification version";
            hw   = rw;
            sw   = r;
        } rrid_transl_en[8:8] = 0x0;

        field {
            name = "rrid_transl_prog";
            desc = "The specification version";
            hw   = rw;
            sw   = rw;
            we;
            onwrite = woclr;
        } rrid_transl_prog[9:9] = 0x0;

        field {
            name = "chk_x";
            desc = "The specification version";
            hw   = rw;
            sw   = r;
        } chk_x[10:10] = 0x1;

        field {
            name = "no_x";
            desc = "The specification version";
            hw   = rw;
            sw   = r;
        } no_x[11:11] = 0x0;

        field {
            name = "no_w";
            desc = "The specification version";
            hw   = rw;
            sw   = r;
        } no_w[12:12] = 0x0;

        field {
            name = "stall_en";
            desc = "The specification version";
            hw   = rw;
            sw   = r;
        } stall_en[13:13] = 0x1;

        field {
            name = "peis";
            desc = "The specification version";
            hw   = rw;
            sw   = r;
        } peis[14:14] = 0x1;

        field {
            name = "pees";
            desc = "The specification version";
            hw   = rw;
            sw   = r;
        } pees[15:15] = 0x0;

        field {
            name = "mfr_en";
            desc = "The specification version";
            hw   = rw;
            sw   = r;
        } mfr_en[16:16] = 0x1;

        field {
            name = "md_entry_num";
            desc = "The specification version";
            hw   = rw;
            sw   = rw;
        } md_entry_num[23:17] = 0x0;

        field {
            name = "md_num";
            desc = "The specification version";
            hw   = rw;
            sw   = r;
        } md_num[29:24] = 0x3F;

        field {
            name = "addrh_en";
            desc = "The specification version";
            hw   = rw;
            sw   = r;
        } addrh_en[30:30] = 0x1;

        field {
            name = "enable";
            desc = "The specification version";
            hw   = rw;
            sw   = rw;
            onwrite = woset;
        } enable[31:31] = 0x0;

    } hwcfg0 @ 0x8;

    reg {
        name = "Device-Directory-Table Pointer";
        desc = "This register contains the PPN of root Device Directory Table and the mode of IOMMU";
        regwidth = 32;

        field {
            name = "rrid_num";
            desc = "Mode of IOMMU is configured in this field (OFF, Bare, 1LVL, 2LVL, 3LVL)";
            hw   = rw;
            sw   = r;
        } rrid_num[15:0] = 0x10;

        field {
            name = "entry_num";
            desc = "When a write is observed by the ddtp, the
                    busy bit is set to 1. When the busy bit is 1, the write
                    to the register is ignored";
            hw   = rw;
            sw   = r;
        } entry_num[31:16] = 0x0;

    } hwcfg1 @ 0x0C;

    reg {
        name = "Device-Directory-Table Pointer";
        desc = "This register contains the PPN of root Device Directory Table and the mode of IOMMU";
        regwidth = 32;

        field {
            name = "prio_entry";
            desc = "Mode of IOMMU is configured in this field (OFF, Bare, 1LVL, 2LVL, 3LVL)";
            hw   = rw;
            sw   = rw;
        } prio_entry[15:0] = 0x30;

        field {
            name = "rrid_transl";
            desc = "When a write is observed by the ddtp, the
                    busy bit is set to 1. When the busy bit is 1, the write
                    to the register is ignored";
            hw   = rw;
            sw   = rw;
        } rrid_transl[31:16] = 0x0;

    } hwcfg2 @ 0x10;

    reg {
        name = "Device-Directory-Table Pointer";
        desc = "This register contains the PPN of root Device Directory Table and the mode of IOMMU";
        regwidth = 32;

        field {
            name = "offset";
            desc = "When a write is observed by the ddtp, the
