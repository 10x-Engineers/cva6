            hw   = rw;
            sw   = r;
        } offset[31:0] = 0x0;

    } entryoffset @ 0x14;

    reg {
        name = "Device-Directory-Table Pointer";
        desc = "This register contains the PPN of root Device Directory Table and the mode of IOMMU";
        regwidth = 32;

        field {
            name = "offset";
            desc = "When a write is observed by the ddtp, the
                    busy bit is set to 1. When the busy bit is 1, the write
                    to the register is ignored";
            hw   = rw;
            sw   = r;
        } base[31:0] = 0x80000000;

    } baseaddr @ 0x18;

    reg {
        name = "MDSTALL";
