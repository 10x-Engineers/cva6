            name = "Lower 22 Bits of Physical Page Number";
            desc = "PPN of Command Queue Base Address";
            hw   = r;
            sw   = rw;
        } md[31:1] = 0x0;

    } mdlck @ 0x40;

    reg {
        name = "Command Queue Base";
        desc = "This 64-bit register (RW) holds the PPN of the root page of the command-queue and number of
