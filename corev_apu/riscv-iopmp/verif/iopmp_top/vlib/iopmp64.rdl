            sw   = rw;
        } md[31:1] = 0x0;

        field {
            name = "Lower 22 Bits of Physical Page Number";
            desc = "PPN of Command Queue Base Address";
            hw   = r;
            sw   = rw;
        } mdh[63:32] = 0x0;
    };



    srcmd_en   srcmd_en_0 @ 0x1000;
    srcmd_r    srcmd_r_0;
    srcmd_w    srcmd_w_0;
