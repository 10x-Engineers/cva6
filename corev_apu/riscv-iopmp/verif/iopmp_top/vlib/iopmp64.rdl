addrmap iopmp_reg {
    name = "I/O Physical Memory Protection";
    desc = "I/O Physical Memory Protection";
    
    default accesswidth = 32;
    addressing = regalign;
    rsvdset = false;
    
    reg {
        name = "VERSION";
        desc = "INFO registers are use to indicate the IOPMP instance configuration info.";
        regwidth=32;

        field {
            name = "vendor";
            desc = "The JEDEC manufacturer ID.";
            hw   = r;
            sw   = r;
        } vendor[23:0] = 0x1;

        field {
            name = "specver";
            desc = "The specification version";
            hw   = r;
            sw   = r;
        } specver[31:24] = 0x1;

    } version @ 0x0;

    reg {
        name = "IMPLEMENTATION";
        desc = "";
        regwidth = 32;

        field {
            name = "impid";
            desc = "";
            hw   = r;
            sw   = r;
        } impid[31:0] = 0x1;

    } implementation @ 0x4;

    reg {
        name = "HWCFG0";
        desc = "";
        regwidth=32;

        field {
            name = "mdcfg_fmt";
            desc = "";
            hw   = rw;
            sw   = r;
        } mdcfg_fmt[1:0] = 0x0;

        field {
            name = "srcmd_fmt";
            desc = "";
            hw   = rw;
            sw   = r;
        } srcmd_fmt[3:2] = 0x0;

        field {
            name = "tor_en";
            desc = "The specification version";
            hw   = rw;
            sw   = r;
        } tor_en[4:4] = 0x0;

        field {
            name = "sps_en";
            desc = "The specification version";
            hw   = rw;
            sw   = r;
        } sps_en[5:5] = 0x0;

        field {
            name = "user_cfg_en";
            desc = "The specification version";
            hw   = rw;
            sw   = r;
        } user_cfg_en[6:6] = 0x0;

        field {
            name = "prient_prog";
            desc = "The specification version";
            hw   = rw;
            sw   = rw;
            we;
            onwrite = woclr;
        } prient_prog[7:7] = 0x0;

        field {
            name = "rrid_transl_en";
            desc = "The specification version";
            hw   = rw;
            sw   = r;
        } rrid_transl_en[8:8] = 0x0;

        field {
            name = "rrid_transl_prog";
            desc = "The specification version";
            hw   = rw;
            sw   = rw;
            we;
            onwrite = woclr;
        } rrid_transl_prog[9:9] = 0x0;

        field {
            name = "chk_x";
            desc = "The specification version";
            hw   = rw;
            sw   = r;
        } chk_x[10:10] = 0x0;

        field {
            name = "no_x";
            desc = "The specification version";
            hw   = rw;
            sw   = r;
        } no_x[11:11] = 0x0;

        field {
            name = "no_w";
            desc = "The specification version";
            hw   = rw;
            sw   = r;
        } no_w[12:12] = 0x0;

        field {
            name = "stall_en";
            desc = "The specification version";
            hw   = rw;
            sw   = r;
        } stall_en[13:13] = 0x0;

        field {
            name = "peis";
            desc = "The specification version";
            hw   = rw;
            sw   = r;
        } peis[14:14] = 0x0;

        field {
            name = "pees";
            desc = "The specification version";
            hw   = rw;
            sw   = r;
        } pees[15:15] = 0x0;

        field {
            name = "mfr_en";
            desc = "The specification version";
            hw   = rw;
            sw   = r;
        } mfr_en[16:16] = 0x0;

        field {
            name = "md_entry_num";
            desc = "The specification version";
            hw   = rw;
            sw   = rw;
        } md_entry_num[23:17] = 0x0;

        field {
            name = "md_num";
            desc = "The specification version";
            hw   = rw;
            sw   = r;
        } md_num[29:24] = 0x0;

        field {
            name = "addrh_en";
            desc = "The specification version";
            hw   = rw;
            sw   = r;
        } addrh_en[30:30] = 0x0;

        field {
            name = "enable";
            desc = "The specification version";
            hw   = rw;
            sw   = rw;
            onwrite = woset;
        } enable[31:31] = 0x0;

    } hwcfg0 @ 0x8;

    reg {
        name = "Device-Directory-Table Pointer";
        desc = "This register contains the PPN of root Device Directory Table and the mode of IOMMU";
        regwidth = 32;
        
        field {
            name = "rrid_num";
            desc = "Mode of IOMMU is configured in this field (OFF, Bare, 1LVL, 2LVL, 3LVL)";
            hw   = rw;
            sw   = r;
        } rrid_num[15:0] = 0x0;

        field {
            name = "entry_num";
            desc = "When a write is observed by the ddtp, the
                    busy bit is set to 1. When the busy bit is 1, the write
                    to the register is ignored";
            hw   = rw;
            sw   = r;
        } entry_num[31:16] = 0x0;
        
    } hwcfg1 @ 0x0C;

    reg {
        name = "Device-Directory-Table Pointer";
        desc = "This register contains the PPN of root Device Directory Table and the mode of IOMMU";
        regwidth = 32;
        
        field {
            name = "prio_entry";
            desc = "Mode of IOMMU is configured in this field (OFF, Bare, 1LVL, 2LVL, 3LVL)";
            hw   = rw;
            sw   = rw;
        } prio_entry[15:0] = 0x0;

        field {
            name = "rrid_transl";
            desc = "When a write is observed by the ddtp, the
                    busy bit is set to 1. When the busy bit is 1, the write
                    to the register is ignored";
            hw   = rw;
            sw   = rw;
        } rrid_transl[31:16] = 0x0;
        
    } hwcfg2 @ 0x10;

    reg {
        name = "Device-Directory-Table Pointer";
        desc = "This register contains the PPN of root Device Directory Table and the mode of IOMMU";
        regwidth = 32;

        field {
            name = "offset";
            desc = "When a write is observed by the ddtp, the
                    busy bit is set to 1. When the busy bit is 1, the write
                    to the register is ignored";
            hw   = rw;
            sw   = r;
        } offset[31:0] = 0x0;
        
    } entryoffset @ 0x14;

    reg {
        name = "MDSTALL and MDSTALLH";
        desc = "This register contains the PPN of root Device Directory Table and the mode of IOMMU";
        regwidth = 64;

        field {
            name = "exempt";
            desc = "When a write is observed by the ddtp, the
                    busy bit is set to 1. When the busy bit is 1, the write
                    to the register is ignored";
            hw   = rw;
            sw   = r;
        } is_stalled[0:0] = 0x0;

        field {
            name = "md";
            desc = "When a write is observed by the ddtp, the
                    busy bit is set to 1. When the busy bit is 1, the write
                    to the register is ignored";
            hw   = r;
            sw   = rw;
        } md[31:1] = 0x0;

        field {
            name = "offset";
            desc = "When a write is observed by the ddtp, the
                    busy bit is set to 1. When the busy bit is 1, the write
                    to the register is ignored";
            hw   = r;
            sw   = rw;
        } mdh[63:32] = 0x0;
        
    } mdstall @ 0x30;

    reg {
        name = "Command Queue Base";
        desc = "This 64-bit register (RW) holds the PPN of the root page of the command-queue and number of
                entries in the queue.";
        regwidth = 32;

        field {
            name = "LOG2SZ - 1";
            desc = "The LOG2SZ-1 field holds the number of entries in command-
                    queue as a log to base 2 minus 1.";
            hw   = r;
            sw   = rw;
        } rrid[15:0] = 0x0;

        field {
            name = "LOG2SZ - 1";
            desc = "The LOG2SZ-1 field holds the number of entries in command-
                    queue as a log to base 2 minus 1.";
            hw   = r;
            sw   = r;
        } rsv[29:16] = 0x0;

        field {
            name = "Lower 22 Bits of Physical Page Number";
            desc = "PPN of Command Queue Base Address";
            hw   = rw;
            sw   = r;
        } stat[31:30] = 0x0;
        
    } rridscp @ 0x38;

    reg {
        name = "Command Queue Base";
        desc = "This 64-bit register (RW) holds the PPN of the root page of the command-queue and number of
                entries in the queue.";
        regwidth = 64;

        field {
            name = "LOG2SZ - 1";
            desc = "The LOG2SZ-1 field holds the number of entries in command-
                    queue as a log to base 2 minus 1.";
            hw   = r;
            sw   = rw;
            onwrite=woset;
        } l[0:0] = 0x0;

        field {
            name = "Lower 22 Bits of Physical Page Number";
            desc = "PPN of Command Queue Base Address";
            hw   = r;
            sw   = rw;
        } md[31:1] = 0x0;

        field {
            name = "Lower 22 Bits of Physical Page Number";
            desc = "PPN of Command Queue Base Address";
            hw   = r;
            sw   = rw;
        } mdh[63:32] = 0x0;
        
    } mdlck @ 0x40;

    reg {
        name = "Command Queue Base";
        desc = "This 64-bit register (RW) holds the PPN of the root page of the command-queue and number of
                entries in the queue.";
        regwidth = 32;

        field {
            name = "LOG2SZ - 1";
            desc = "The LOG2SZ-1 field holds the number of entries in command-
                    queue as a log to base 2 minus 1.";
            hw   = r;
            sw   = rw;
            onwrite = woset;
        } l[0:0] = 0x0;

        field {
            name = "LOG2SZ - 1";
            desc = "The LOG2SZ-1 field holds the number of entries in command-
                    queue as a log to base 2 minus 1.";
            hw   = r;
            sw   = rw;
        } f[6:1] = 0x0;

        field {
            name = "Lower 22 Bits of Physical Page Number";
            desc = "PPN of Command Queue Base Address";
            hw   = r;
            sw   = r;
        } rsv[31:7] = 0x0;
        
    } mdcfglck @ 0x48;

    reg {
        name = "Command Queue Base";
        desc = "This 64-bit register (RW) holds the PPN of the root page of the command-queue and number of
                entries in the queue.";
        regwidth = 32;

        field {
            name = "LOG2SZ - 1";
            desc = "The LOG2SZ-1 field holds the number of entries in command-
                    queue as a log to base 2 minus 1.";
            hw   = r;
            sw   = rw;
            onwrite = woset;
        } l[0:0] = 0x0;

        field {
            name = "LOG2SZ - 1";
            desc = "The LOG2SZ-1 field holds the number of entries in command-
                    queue as a log to base 2 minus 1.";
            hw   = r;
            sw   = rw;
        } f[16:1] = 0x0;

        field {
            name = "Lower 22 Bits of Physical Page Number";
            desc = "PPN of Command Queue Base Address";
            hw   = r;
            sw   = r;
        } rsv[31:17] = 0x0;
        
    } entrylck @ 0x4C;

    reg {
        name = "Command Queue Base";
        desc = "This 64-bit register (RW) holds the PPN of the root page of the command-queue and number of
                entries in the queue.";
        regwidth = 32;

        field {
            name = "LOG2SZ - 1";
            desc = "The LOG2SZ-1 field holds the number of entries in command-
                    queue as a log to base 2 minus 1.";
            hw   = r;
            sw   = rw;
            onwrite = woset;
        } l[0:0] = 0x0;

        field {
            name = "LOG2SZ - 1";
            desc = "The LOG2SZ-1 field holds the number of entries in command-
                    queue as a log to base 2 minus 1.";
            hw   = rw;
            sw   = rw;
        } ie[1:1] = 0x1;

        field {
            name = "LOG2SZ - 1";
            desc = "The LOG2SZ-1 field holds the number of entries in command-
                    queue as a log to base 2 minus 1.";
            hw   = r;
            sw   = rw;
        } rs[2:2] = 0x0;

        field {
            name = "LOG2SZ - 1";
            desc = "The LOG2SZ-1 field holds the number of entries in command-
                    queue as a log to base 2 minus 1.";
            hw   = r;
            sw   = rw;
        } msi_en[3:3] = 0x0;

        field {
            name = "LOG2SZ - 1";
            desc = "The LOG2SZ-1 field holds the number of entries in command-
                    queue as a log to base 2 minus 1.";
            hw   = r;
            sw   = rw;
        } stall_violation_en[4:4] = 0x0;

        field {
            name = "LOG2SZ - 1";
            desc = "The LOG2SZ-1 field holds the number of entries in command-
                    queue as a log to base 2 minus 1.";
            hw   = r;
            sw   = r;
        } rsv1[7:5] = 0x0;

        field {
            name = "LOG2SZ - 1";
            desc = "The LOG2SZ-1 field holds the number of entries in command-
                    queue as a log to base 2 minus 1.";
            hw   = r;
            sw   = rw;
        } msidata[18:8] = 0x0;

        field {
            name = "Lower 22 Bits of Physical Page Number";
            desc = "PPN of Command Queue Base Address";
            hw   = r;
            sw   = r;
        } rsv2[31:19] = 0x0;
        
    } err_cfg @ 0x60;

    reg {
        name = "Command Queue Base";
        desc = "This 64-bit register (RW) holds the PPN of the root page of the command-queue and number of
                entries in the queue.";
        regwidth = 32;

        field {
            name = "LOG2SZ - 1";
            desc = "The LOG2SZ-1 field holds the number of entries in command-
                    queue as a log to base 2 minus 1.";
            hw   = rw;
            sw   = rw;
            we;
            onwrite = woclr;
        } v[0:0] = 0x0;

        field {
            name = "LOG2SZ - 1";
            desc = "The LOG2SZ-1 field holds the number of entries in command-
                    queue as a log to base 2 minus 1.";
            hw   = rw;
            sw   = r;
        } ttype[2:1] = 0x0;

        field {
            name = "LOG2SZ - 1";
            desc = "The LOG2SZ-1 field holds the number of entries in command-
                    queue as a log to base 2 minus 1.";
            hw   = rw;
            sw   = r;
        } msi_werr[3:3] = 0x0;

        field {
            name = "LOG2SZ - 1";
            desc = "The LOG2SZ-1 field holds the number of entries in command-
                    queue as a log to base 2 minus 1.";
            hw   = rw;
            sw   = r;
        } etype[7:4] = 0x0;

        field {
            name = "LOG2SZ - 1";
            desc = "The LOG2SZ-1 field holds the number of entries in command-
                    queue as a log to base 2 minus 1.";
            hw   = rw;
            sw   = r;
        } svc[8:8] = 0x0;

        field {
            name = "Lower 22 Bits of Physical Page Number";
            desc = "PPN of Command Queue Base Address";
            hw   = r;
            sw   = r;
        } rsv[31:9] = 0x0;
        
    } err_info @ 0x64;

    reg {
        name = "Command Queue Base";
        desc = "This 64-bit register (RW) holds the PPN of the root page of the command-queue and number of
                entries in the queue.";
        regwidth = 64;

        field {
            name = "Lower 22 Bits of Physical Page Number";
            desc = "PPN of Command Queue Base Address";
            hw   = rw;
            sw   = r;
        } addr[31:0] = 0x0;

        field {
            name = "Lower 22 Bits of Physical Page Number";
            desc = "PPN of Command Queue Base Address";
            hw   = rw;
            sw   = r;
        } addrh[63:32] = 0x0;
        
    } err_reqaddr @ 0x68;

    reg {
        name = "Command Queue Base";
        desc = "This 64-bit register (RW) holds the PPN of the root page of the command-queue and number of
                entries in the queue.";
        regwidth = 32;

        field {
            name = "Lower 22 Bits of Physical Page Number";
            desc = "PPN of Command Queue Base Address";
            hw   = rw;
            sw   = r;
        } rrid[15:0] = 0x0;

        field {
            name = "Lower 22 Bits of Physical Page Number";
            desc = "PPN of Command Queue Base Address";
            hw   = rw;
            sw   = r;
        } eid[31:16] = 0x0;
        
    } err_reqid @ 0x70;

    reg {
        name = "Command Queue Base";
        desc = "This 64-bit register (RW) holds the PPN of the root page of the command-queue and number of
                entries in the queue.";
        regwidth = 32;

        field {
            name = "Lower 22 Bits of Physical Page Number";
            desc = "PPN of Command Queue Base Address";
            hw   = rw;
            sw   = r;
        } svw[15:0] = 0x0;

        field {
            name = "Lower 22 Bits of Physical Page Number";
            desc = "PPN of Command Queue Base Address";
            hw   = r;
            sw   = rw;
        } svi[27:16] = 0x0;

        field {
            name = "Lower 22 Bits of Physical Page Number";
            desc = "PPN of Command Queue Base Address";
            hw   = r;
            sw   = r;
        } rsv[30:28] = 0x0;

        field {
            name = "Lower 22 Bits of Physical Page Number";
            desc = "PPN of Command Queue Base Address";
            hw   = rw;
            sw   = r;
        } svs[31:31] = 0x0;
        
    } err_mfr @ 0x74;

    reg {
        name = "Command Queue Base";
        desc = "This 64-bit register (RW) holds the PPN of the root page of the command-queue and number of
                entries in the queue.";
        regwidth = 64;

        field {
            name = "Lower 22 Bits of Physical Page Number";
            desc = "PPN of Command Queue Base Address";
            hw   = rw;
            sw   = r;
        } msiaddr[31:0] = 0x0;

        field {
            name = "Lower 22 Bits of Physical Page Number";
            desc = "PPN of Command Queue Base Address";
            hw   = rw;
            sw   = r;
        } msiaddrh[63:32] = 0x0;
        
    } err_msiaddr @ 0x78;
    
    reg mdcfg{
        name = "Command Queue Base";
        desc = "This 64-bit register (RW) holds the PPN of the root page of the command-queue and number of
                entries in the queue.";
        regwidth = 32;

        field {
            name = "Lower 22 Bits of Physical Page Number";
            desc = "PPN of Command Queue Base Address";
            hw   = r;
            sw   = rw;
        } t[15:0] = 0x0;

        field {
            name = "Lower 22 Bits of Physical Page Number";
            desc = "PPN of Command Queue Base Address";
            hw   = r;
            sw   = r;
        } rsv[31:16] = 0x0;
        
    };

    mdcfg mdcfg_0 @ 0x0800;
    mdcfg mdcfg_1;
    mdcfg mdcfg_2;
