    mdcfg mdcfg_40;
    mdcfg mdcfg_41;
    mdcfg mdcfg_42;
    mdcfg mdcfg_43;
    mdcfg mdcfg_44;
    mdcfg mdcfg_45;
    mdcfg mdcfg_46;
    mdcfg mdcfg_47;
    mdcfg mdcfg_48;
    mdcfg mdcfg_49;
    mdcfg mdcfg_50;
    mdcfg mdcfg_51;
    mdcfg mdcfg_52;
    mdcfg mdcfg_53;
    mdcfg mdcfg_54;
    mdcfg mdcfg_55;
    mdcfg mdcfg_56;
    mdcfg mdcfg_57;
    mdcfg mdcfg_58;
    mdcfg mdcfg_59;
    mdcfg mdcfg_60;
    mdcfg mdcfg_61;
    mdcfg mdcfg_62;
    // TODO SRCMD_PERM needs to be replaced with srcmd perm
    // TODO Default value of few registers needs to be updated based upon parameter
    reg srcmd_en{
        name = "Command Queue Base";
        desc = "This 64-bit register (RW) holds the PPN of the root page of the command-queue and number of
                entries in the queue.";
        regwidth = 64;

        field {
            name = "Lower 22 Bits of Physical Page Number";
            desc = "PPN of Command Queue Base Address";
            hw   = r;
            sw   = rw;
            onwrite = woset;
        } l[0:0] = 0x0;

        field {
            name = "Lower 22 Bits of Physical Page Number";
            desc = "PPN of Command Queue Base Address";
            hw   = r;
            sw   = rw;
        } md[31:1] = 0x0;

        field {
